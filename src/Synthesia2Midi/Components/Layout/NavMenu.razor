@inject IJSRuntime JS

<header class="s2m-nav">
    <div class="s2m-nav-inner">
        <a class="s2m-nav-brand" href="nouvelle">syn2mid</a>
        <nav class="s2m-nav-items" aria-label="Navigation principale">
            <NavLink class="s2m-nav-item" ActiveClass="is-active" href="nouvelle">
                <Icon Name="plus" Size="18" /><span>Nouvelle conversion</span>
            </NavLink>
            <NavLink class="s2m-nav-item" ActiveClass="is-active" href="historique">
                <Icon Name="history" Size="18" /><span>Historique</span>
            </NavLink>
        </nav>
        <div class="s2m-nav-right">
            <div class="s2m-theme" role="group" aria-label="Thème">
                @foreach (var option in ThemeOptions)
                {
                    var on = option.Value == _theme;
                    <button type="button"
                            class="s2m-theme-opt @(on ? "is-on" : null)"
                            aria-pressed="@(on ? "true" : "false")"
                            title="@option.Label"
                            aria-label="@option.Label"
                            @onclick="() => SetThemeAsync(option.Value)">
                        <Icon Name="@option.Icon" Size="16" />
                    </button>
                }
            </div>
        </div>
    </div>
</header>

@code {
    private sealed record ThemeOption(string Value, string Label, string Icon);

    private static readonly ThemeOption[] ThemeOptions =
    {
        new("system", "Thème du système", "monitor"),
        new("light", "Thème clair", "sun"),
        new("dark", "Thème sombre", "moon"),
    };

    private string _theme = "system";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }
        try
        {
            var stored = await JS.InvokeAsync<string>("s2mUi.getTheme");
            if (stored is "system" or "light" or "dark" && stored != _theme)
            {
                _theme = stored;
                StateHasChanged();
            }
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Prérendu statique : pas encore de JS disponible.
        }
    }

    private async Task SetThemeAsync(string value)
    {
        _theme = value;
        try
        {
            await JS.InvokeVoidAsync("s2mUi.setTheme", value);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
