@* Jeu d'icônes maison du design system syn2mid : trait de 1,75 px, grille de 24,
   dessiné en currentColor ; icônes de transport pleines. *@
<svg class="s2m-icon @(Def.Spin ? "s2m-spin" : null) @Class" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="@(Def.Fill ? "currentColor" : "none")" stroke="@(Def.Fill ? "none" : "currentColor")"
     stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label" focusable="false">
    @foreach (var d in Def.Paths)
    {
        <path d="@d" />
    }
</svg>

@code {
    [Parameter] public string Name { get; set; } = "note";
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Class { get; set; }

    private IconDef Def => Icons.TryGetValue(Name, out var d) ? d : Icons["note"];

    private sealed record IconDef(string[] Paths, bool Fill = false, bool Spin = false);

