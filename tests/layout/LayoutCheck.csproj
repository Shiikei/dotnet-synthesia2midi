<Project Sdk="Microsoft.NET.Sdk">
  <!-- Contrôle hors ligne de DetectLayout sur des lignes de pixels brutes (voir run.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Usings implicites du SDK Web dont dépend le code partagé. -->
    <Using Include="Microsoft.Extensions.Logging" />
    <Compile Include="../../src/Synthesia2Midi/Services/KeyboardAnalysisService.cs" />
    <Compile Include="../../src/Synthesia2Midi/Services/Abstractions/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>
</Project>
